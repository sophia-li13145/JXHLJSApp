<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JXHLJSApp.Pages.Warehouse.MaterialReceivingSummaryView">
    <Grid BackgroundColor="#99000000"
          Padding="32,16"
          VerticalOptions="Fill"
          HorizontalOptions="Fill">
        <Border BackgroundColor="White"
                StrokeThickness="0"
                Padding="18"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="SummaryTitle"
                           TextColor="#0A2C61"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <Label Grid.Column="1"
                           Text="×"
                           TextColor="#8EA0B8"
                           FontSize="28">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseSummaryTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Border Grid.Row="1"
                        BackgroundColor="#EDF4FC"
                        StrokeThickness="0"
                        Padding="12,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="合计件数" FontSize="12" TextColor="#38557C" />
                            <Label x:Name="SummaryTotalCount"
                                   FontAttributes="Bold"
                                   TextColor="#0A2C61" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="合计重量"
                                   FontSize="12"
                                   TextColor="#38557C"
                                   HorizontalTextAlignment="End" />
                            <Label x:Name="SummaryTotalWeight"
                                   FontAttributes="Bold"
                                   TextColor="#00A060"
                                   HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <CollectionView Grid.Row="2"
                                x:Name="SummaryList"
                                EmptyView="暂无待汇总物料"
                                MinimumHeightRequest="96">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#FAFCFF"
                                    Stroke="#DDE6F2"
                                    StrokeThickness="1"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="12">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding materialName}"
                                               TextColor="#0A3C7D"
                                               FontSize="16"
                                               FontAttributes="Bold" />
                                        <Border BackgroundColor="#F2F4F8"
                                                StrokeThickness="0"
                                                Padding="8,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="5" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding materialType}"
                                                   TextColor="#2D3B4F"
                                                   FontSize="12" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <Border Grid.Column="1"
                                            BackgroundColor="#F8FAFD"
                                            StrokeThickness="0"
                                            Padding="8,2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="5" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding originPlace}"
                                               TextColor="#0A2C61"
                                               FontSize="12"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <Label Grid.Row="1"
                                           Text="{Binding count, StringFormat='件数: {0}'}"
                                           TextColor="#38557C" />
                                    <Label Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding totalWeightDisplay, StringFormat='总重: {0}'}"
                                           TextColor="#00A060"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Grid.Row="3"
                        Text="关闭返回"
                        BackgroundColor="#1F447E"
                        TextColor="White"
                        FontSize="17"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnCloseSummaryClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
