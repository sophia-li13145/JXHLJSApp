<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="JXHLJSApp.Pages.CameraScanPage"
             BackgroundColor="#101828">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button Text="‹ 返回" BackgroundColor="Transparent" TextColor="White" Clicked="OnCancelClicked" />
            <Label x:Name="ScanTitle" Grid.Column="1" TextColor="White" FontAttributes="Bold"
                   FontSize="20" VerticalTextAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1">
            <zxing:CameraBarcodeReaderView x:Name="Reader" CameraLocation="Rear"
                                           IsDetecting="False" BarcodesDetected="OnBarcodesDetected" />
            <Border WidthRequest="220" HeightRequest="220" HorizontalOptions="Center" VerticalOptions="Center"
                    Stroke="White" StrokeThickness="2" BackgroundColor="Transparent" InputTransparent="True">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
            </Border>
        </Grid>
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Label Text="将二维码对准框内" TextColor="White" HorizontalTextAlignment="Center" />
            <Button x:Name="TorchButton" Text="打开手电筒" Clicked="OnTorchClicked" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
