<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JXHLJSApp.Pages.WorkStart.WorkPausePage"
             BackgroundColor="#F4F6FA"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Border BackgroundColor="#244B88" StrokeThickness="0" Padding="20,18,20,14" HeightRequest="66">
            <Border.StrokeShape><RoundRectangle CornerRadius="0,0,18,18" /></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Text="‹ 返回" TextColor="White" FontSize="15" VerticalOptions="Center">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" Text="暂停作业" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                <BoxView Grid.Column="2" WidthRequest="48" Opacity="0" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,18,22,28" Spacing="16">
                <Border BackgroundColor="White" StrokeThickness="0" Padding="20,22">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="停工信息" TextColor="#0A2E69" FontSize="19" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="当前执行中工单" TextColor="#4B6688" FontSize="15" VerticalOptions="Center" />
                            <Label x:Name="WorkOrderNoLabel" Grid.Column="1" Text="--" TextColor="#001431" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#DDE6F1" />
                        <Label Text="产出长度数量 *" TextColor="#0A2E69" FontSize="18" FontAttributes="Bold" />
                        <Border BackgroundColor="#F7F9FC" Stroke="#244B88" StrokeThickness="1.5" Padding="16,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Entry x:Name="OutputLengthEntry" Keyboard="Numeric" Placeholder="请输入数字" PlaceholderColor="#9AA9BF" FontSize="26" FontAttributes="Bold" TextColor="#001431" BackgroundColor="Transparent" HeightRequest="72" HorizontalTextAlignment="Center" />
                        </Border>
                        <Label Text="只需填写数字，例如 12.5" TextColor="#7A8BA6" FontSize="14" />
                        <Button x:Name="ConfirmButton" Text="确认暂停" BackgroundColor="#F2C04B" TextColor="#001431" FontSize="20" FontAttributes="Bold" CornerRadius="12" HeightRequest="64" Margin="0,8,0,0" Clicked="OnConfirmPauseClicked" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
