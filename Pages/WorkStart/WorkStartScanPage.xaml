<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JXHLJSApp.Pages.WorkStart.WorkStartScanPage"
             BackgroundColor="#F4F6FA"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Border BackgroundColor="#244B88" StrokeThickness="0" Padding="12,8">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,18,18" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="72,*,72">
                <Button Text="‹ 返回" Clicked="OnBackClicked" BackgroundColor="Transparent"
                        TextColor="White" FontSize="15" Padding="0" MinimumHeightRequest="48" />
                <Label x:Name="PageTitleLabel" Grid.Column="1" Text="扫码上机" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,24" Spacing="18">
                <Border BackgroundColor="White" Stroke="#244B88" StrokeThickness="2" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Button x:Name="ScanButton" Text="摄像头扫描机台二维码" Clicked="OnScanClicked"
                                BackgroundColor="#244B88" TextColor="White" MinimumHeightRequest="48" />
                        <Label x:Name="ScanHintLabel" Text="也可按设备右侧扫描键扫描机台码" TextColor="#475467" FontSize="14" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="或" TextColor="#647895" FontSize="14" HorizontalTextAlignment="Center" />

                <Border BackgroundColor="White" Stroke="#DDE6F1" StrokeThickness="1" Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,66" ColumnSpacing="10" VerticalOptions="Center">
                        <Entry x:Name="MachineNoEntry" Placeholder="手动输入机台编号" PlaceholderColor="#7A8797" FontSize="15" BackgroundColor="#F8FAFD" ReturnType="Done" Completed="OnConfirmClicked" />
                        <Button Grid.Column="1" Text="确认" FontSize="16" FontAttributes="Bold" BackgroundColor="#0B3D8B" TextColor="White" CornerRadius="14" Padding="0" Clicked="OnConfirmClicked" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
