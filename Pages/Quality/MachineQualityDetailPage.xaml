<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JXHLJSApp.Pages.Quality.MachineQualityDetailPage"
             BackgroundColor="#F4F6FA"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border BackgroundColor="#244B88" StrokeThickness="0" Padding="16,22,16,14" HeightRequest="80">
            <Border.StrokeShape><RoundRectangle CornerRadius="0,0,18,18" /></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Text="‹ 返回" TextColor="White" FontSize="15" VerticalOptions="Center">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Label.GestureRecognizers>
                </Label>
                <Label x:Name="TitleLabel" Grid.Column="1" Text="执行工序质检" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                <Button x:Name="ScanMaterialButton" Grid.Column="2" Text="▣  扫物料" BackgroundColor="White" TextColor="#0B3D8B" BorderColor="#0B3D8B" BorderWidth="1" CornerRadius="8" HeightRequest="38" Padding="10,0" FontSize="13" FontAttributes="Bold" Clicked="OnScanMaterialClicked" IsVisible="False" />
            </Grid>
        </Border>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,18" Spacing="18">
                <Label x:Name="MaterialScanStatusLabel" IsVisible="False" TextColor="#9A6700" FontSize="14" />
                <Border BackgroundColor="White" Stroke="#DDE6F1" StrokeThickness="1" Padding="20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="InfoTitleLabel" Text="生产卡片信息" TextColor="#00346F" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            <Button x:Name="InfoScanMaterialButton" Grid.Column="1" Text="▣  右侧键扫码" BackgroundColor="White" TextColor="#0B3D8B" BorderColor="#0B3D8B" BorderWidth="1" CornerRadius="6" HeightRequest="34" Padding="10,0" FontSize="13" FontAttributes="Bold" Clicked="OnScanMaterialClicked" IsVisible="False" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#C8D2DF" />
                        <Grid x:Name="InfoGrid" ColumnDefinitions="*,*" RowSpacing="14" ColumnSpacing="16" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="MaterialInfoCard" BackgroundColor="White" Stroke="#DDE6F1" StrokeThickness="1" Padding="20" IsVisible="False">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="物料信息" TextColor="#00346F" FontSize="16" FontAttributes="Bold" />
                        <BoxView HeightRequest="1" Color="#C8D2DF" />
                        <Grid x:Name="MaterialGrid" ColumnDefinitions="*,*" RowSpacing="14" ColumnSpacing="16" />
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="InspectionItemCard" BackgroundColor="White" Stroke="#DDE6F1" StrokeThickness="1" Padding="20" IsVisible="False">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="检验项目标准" TextColor="#00346F" FontSize="16" FontAttributes="Bold" />
                        <BoxView HeightRequest="1" Color="#C8D2DF" />
                        <VerticalStackLayout x:Name="InspectionItemList" Spacing="10" />
                    </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="White" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <VerticalStackLayout x:Name="InspectionInputFields" Spacing="16">
                        <Label x:Name="InputTitleLabel" Text="检验项目录入" TextColor="#051B3D" FontSize="18" FontAttributes="Bold" />
                        <Grid x:Name="AcidInputPanel" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="16" IsVisible="False">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8">
                                <Label Text="检验日期 (年月日) *" TextColor="#051B3D" FontAttributes="Bold" />
                                <DatePicker x:Name="AcidDatePicker" Format="yyyy/MM/dd" BackgroundColor="#F8FAFD" TextColor="#051B3D" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8">
                                <Label Text="磷化温度" TextColor="#051B3D" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,36" ColumnSpacing="0">
                                    <Entry x:Name="PhosphatingTemperatureEntry" Placeholder="手动录入" Keyboard="Numeric" BackgroundColor="#F8FAFD" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Button Text="▲" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference PhosphatingTemperatureEntry}" Clicked="OnIncrementNumericClicked" />
                                        <Button Text="▼" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference PhosphatingTemperatureEntry}" Clicked="OnDecrementNumericClicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="8">
                                <Label Text="总酸" TextColor="#051B3D" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,36" ColumnSpacing="0">
                                    <Entry x:Name="TotalAcidEntry" Placeholder="手动录入" Keyboard="Numeric" BackgroundColor="#F8FAFD" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Button Text="▲" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference TotalAcidEntry}" Clicked="OnIncrementNumericClicked" />
                                        <Button Text="▼" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference TotalAcidEntry}" Clicked="OnDecrementNumericClicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="8">
                                <Label Text="游离酸" TextColor="#051B3D" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,36" ColumnSpacing="0">
                                    <Entry x:Name="FreeAcidEntry" Placeholder="手动录入" Keyboard="Numeric" BackgroundColor="#F8FAFD" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Button Text="▲" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference FreeAcidEntry}" Clicked="OnIncrementNumericClicked" />
                                        <Button Text="▼" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference FreeAcidEntry}" Clicked="OnDecrementNumericClicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="8">
                                <Label Text="皂化温度" TextColor="#051B3D" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,36" ColumnSpacing="0">
                                    <Entry x:Name="SaponificationTemperatureEntry" Placeholder="手动录入" Keyboard="Numeric" BackgroundColor="#F8FAFD" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Button Text="▲" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference SaponificationTemperatureEntry}" Clicked="OnIncrementNumericClicked" />
                                        <Button Text="▼" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference SaponificationTemperatureEntry}" Clicked="OnDecrementNumericClicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="8">
                                <Label Text="皂化PH值" TextColor="#051B3D" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,36" ColumnSpacing="0">
                                    <Entry x:Name="SaponificationPhEntry" Placeholder="手动录入" Keyboard="Numeric" BackgroundColor="#F8FAFD" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Button Text="▲" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference SaponificationPhEntry}" Clicked="OnIncrementNumericClicked" />
                                        <Button Text="▼" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference SaponificationPhEntry}" Clicked="OnDecrementNumericClicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="8">
                                <Label Text="盐酸1浓度" TextColor="#051B3D" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,36" ColumnSpacing="0">
                                    <Entry x:Name="HydrochloricAcid1Entry" Placeholder="手动录入" Keyboard="Numeric" BackgroundColor="#F8FAFD" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Button Text="▲" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference HydrochloricAcid1Entry}" Clicked="OnIncrementNumericClicked" />
                                        <Button Text="▼" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference HydrochloricAcid1Entry}" Clicked="OnDecrementNumericClicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="8">
                                <Label Text="盐酸2浓度" TextColor="#051B3D" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,36" ColumnSpacing="0">
                                    <Entry x:Name="HydrochloricAcid2Entry" Placeholder="手动录入" Keyboard="Numeric" BackgroundColor="#F8FAFD" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Button Text="▲" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference HydrochloricAcid2Entry}" Clicked="OnIncrementNumericClicked" />
                                        <Button Text="▼" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference HydrochloricAcid2Entry}" Clicked="OnDecrementNumericClicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="4" Grid.Column="0" Spacing="8">
                                <Label Text="总酸取样" TextColor="#051B3D" FontAttributes="Bold" />
                                <Entry x:Name="TotalAcidSamplingEntry" Placeholder="手动录入" BackgroundColor="#F8FAFD" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="4" Grid.Column="1" Spacing="8">
                                <Label Text="游离酸取样" TextColor="#051B3D" FontAttributes="Bold" />
                                <Entry x:Name="FreeAcidSamplingEntry" Placeholder="手动录入" BackgroundColor="#F8FAFD" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="5" Grid.Column="0" Spacing="8">
                                <Label Text="酸比" TextColor="#051B3D" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,36" ColumnSpacing="0">
                                    <Entry x:Name="AcidRatioEntry" Placeholder="手动录入" Keyboard="Numeric" BackgroundColor="#F8FAFD" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Button Text="▲" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference AcidRatioEntry}" Clicked="OnIncrementNumericClicked" />
                                        <Button Text="▼" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference AcidRatioEntry}" Clicked="OnDecrementNumericClicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="5" Grid.Column="1" Spacing="8">
                                <Label Text="记录人 *" TextColor="#051B3D" FontAttributes="Bold" />
                                <Entry x:Name="RecorderEntry" IsReadOnly="True" BackgroundColor="#EEF3FA" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid x:Name="ProcessInputPanel" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="16">
                            <VerticalStackLayout x:Name="CoilDiameterInputPanel" Grid.Row="0" Grid.Column="0" Spacing="8">
                                <Label Text="圈径控制480－680mm" TextColor="#051B3D" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Picker x:Name="CoilDiameterPicker" BackgroundColor="#F8FAFD" TextColor="#051B3D" HeightRequest="52" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="CoilDiameterDescriptionPanel" Grid.Row="0" Grid.Column="1" Spacing="8">
                                <Label Text="圈径描述" TextColor="#051B3D" FontAttributes="Bold" />
                                <Entry x:Name="CoilDiameterDescriptionEntry" Placeholder="可为空" MaxLength="255" BackgroundColor="#F8FAFD" HeightRequest="52" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="CoilPitchInputPanel" Grid.Row="1" Grid.Column="0" Spacing="8">
                                <Label Text="圈距控制≤80mm" TextColor="#051B3D" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Picker x:Name="CoilPitchPicker" BackgroundColor="#F8FAFD" TextColor="#051B3D" HeightRequest="52" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="CoilPitchDescriptionPanel" Grid.Row="1" Grid.Column="1" Spacing="8">
                                <Label Text="圈距描述" TextColor="#051B3D" FontAttributes="Bold" />
                                <Entry x:Name="CoilPitchDescriptionEntry" Placeholder="可为空" MaxLength="255" BackgroundColor="#F8FAFD" HeightRequest="52" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="ActualDiameterInputPanel" Grid.Row="2" Grid.Column="0" Spacing="8">
                                <Label x:Name="ActualDiameterTitleLabel" Text="实测直径 (mm) *" TextColor="#051B3D" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Entry x:Name="ActualDiameterEntry" Placeholder="输入测量直径" Keyboard="Text" BackgroundColor="#F8FAFD" HeightRequest="52" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="DiameterJudgmentPanel" Grid.Row="2" Grid.Column="1" Spacing="8">
                                <Label Text="直径判定" TextColor="#051B3D" FontAttributes="Bold" />
                                <Picker x:Name="DiameterJudgmentPicker" BackgroundColor="#F8FAFD" TextColor="#051B3D" HeightRequest="52" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="StrengthInputPanel" Grid.Row="3" Grid.Column="0" Spacing="8">
                                <Label x:Name="StrengthTitleLabel" Text="实测强度MPa" TextColor="#051B3D" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Entry x:Name="StrengthEntry" Placeholder="检测强度值" Keyboard="Numeric" BackgroundColor="#F8FAFD" HeightRequest="52" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="StrengthJudgmentPanel" Grid.Row="3" Grid.Column="1" Spacing="8">
                                <Label Text="强度判定" TextColor="#051B3D" FontAttributes="Bold" />
                                <Picker x:Name="StrengthJudgmentPicker" BackgroundColor="#F8FAFD" TextColor="#051B3D" HeightRequest="52" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="ElongationInputPanel" Grid.Row="4" Grid.Column="0" Spacing="8">
                                <Label Text="延伸率 (%)" TextColor="#051B3D" FontAttributes="Bold" />
                                <Entry x:Name="ElongationEntry" Placeholder="可为空" Keyboard="Numeric" BackgroundColor="#F8FAFD" HeightRequest="52" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="SurfaceInputPanel" Grid.Row="4" Grid.Column="1" Spacing="8">
                                <Label Text="表面描述" TextColor="#051B3D" FontAttributes="Bold" />
                                <Entry x:Name="SurfaceEntry" Placeholder="正常" BackgroundColor="#F8FAFD" HeightRequest="52" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="SurfaceJudgmentPanel" Grid.Row="5" Grid.Column="0" Spacing="8">
                                <Label Text="表面判定" TextColor="#051B3D" FontAttributes="Bold" />
                                <Picker x:Name="SurfaceJudgmentPicker" BackgroundColor="#F8FAFD" TextColor="#051B3D" HeightRequest="52" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="ContinuousUnqualifiedPanel" Grid.Row="5" Grid.Column="1" Spacing="8">
                                <Label Text="是否连续性不合格品" TextColor="#051B3D" FontAttributes="Bold" />
                                <Picker x:Name="ContinuousUnqualifiedPicker" BackgroundColor="#F8FAFD" TextColor="#051B3D" HeightRequest="52" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="EmployeeInterventionPanel" Grid.Row="6" Grid.Column="0" Spacing="8">
                                <Label Text="是否员工干预" TextColor="#051B3D" FontAttributes="Bold" />
                                <Picker x:Name="EmployeeInterventionPicker" BackgroundColor="#F8FAFD" TextColor="#051B3D" HeightRequest="52" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid x:Name="HeatTreatmentInputPanel" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="16" IsVisible="False">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8">
                                <Label Text="需质检数量" TextColor="#051B3D" FontAttributes="Bold" />
                                <Entry x:Name="TotalInspectQtyEntry" IsReadOnly="True" BackgroundColor="#EEF3FA" Text="—" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8">
                                <Label Text="已质检数量" TextColor="#051B3D" FontAttributes="Bold" />
                                <Entry x:Name="InspectedQtyEntry" IsReadOnly="True" BackgroundColor="#EEF3FA" Text="—" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="8">
                                <Label Text="未质检数量" TextColor="#D32F2F" FontAttributes="Bold" />
                                <Entry x:Name="UninspectedQtyEntry" IsReadOnly="True" BackgroundColor="#EEF3FA" TextColor="#D32F2F" Text="—" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="8">
                                <Label x:Name="HeatActualDiameterTitleLabel" Text="实测直径 (mm) *" TextColor="#051B3D" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Grid ColumnDefinitions="*,36" ColumnSpacing="0">
                                    <Entry x:Name="HeatActualDiameterEntry" Placeholder="输入测量直径" Keyboard="Text" TextChanged="OnHeatDiameterTextChanged" BackgroundColor="#F8FAFD" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Button Text="▲" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference HeatActualDiameterEntry}" Clicked="OnIncrementNumericClicked" />
                                        <Button Text="▼" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference HeatActualDiameterEntry}" Clicked="OnDecrementNumericClicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="8">
                                <Label Text="标准直径 (mm)" TextColor="#051B3D" FontAttributes="Bold" />
                                <Entry x:Name="StandardDiameterEntry" Placeholder="标准直径" Keyboard="Numeric" BackgroundColor="#EEF3FA" IsReadOnly="True" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="8">
                                <Label Text="断后直径 (mm) *" TextColor="#051B3D" FontAttributes="Bold" />
                                <Entry x:Name="BrokenDiameterEntry" Placeholder="输入断后直径" Keyboard="Numeric" TextChanged="OnHeatDiameterTextChanged" BackgroundColor="#F8FAFD" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="8">
                                <Border BackgroundColor="#ECFBF1" Stroke="#B9F1CB" StrokeThickness="1" Padding="14">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="断面收缩率 (%)" TextColor="#009C44" FontAttributes="Bold" />
                                        <Label x:Name="SectionShrinkageLabel" Text="-" TextColor="#009C44" FontSize="20" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="8">
                                <Label x:Name="HeatStrengthTitleLabel" Text="实测强度MPa" TextColor="#051B3D" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Grid ColumnDefinitions="*,36" ColumnSpacing="0">
                                    <Entry x:Name="TensileStrengthEntry" Placeholder="输入实测强度" Keyboard="Numeric" BackgroundColor="#F8FAFD" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Button Text="▲" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference TensileStrengthEntry}" Clicked="OnIncrementNumericClicked" />
                                        <Button Text="▼" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference TensileStrengthEntry}" Clicked="OnDecrementNumericClicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="4" Grid.Column="0" Spacing="8">
                                <Label Text="延伸率 (%)" TextColor="#051B3D" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,36" ColumnSpacing="0">
                                    <Entry x:Name="HeatElongationEntry" Placeholder="可为空" Keyboard="Numeric" BackgroundColor="#F8FAFD" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Button Text="▲" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference HeatElongationEntry}" Clicked="OnIncrementNumericClicked" />
                                        <Button Text="▼" HeightRequest="24" Padding="0" FontSize="10" BackgroundColor="#F8FAFD" TextColor="#7A8798" BorderColor="#DDE6F1" BorderWidth="0" CommandParameter="{x:Reference HeatElongationEntry}" Clicked="OnDecrementNumericClicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout x:Name="TorsionInputPanel" Spacing="8" IsVisible="False">
                            <Label x:Name="TorsionTitleLabel" Text="扭转" TextColor="#051B3D" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            <Entry x:Name="TorsionEntry" Placeholder="输入扭转" Keyboard="Numeric" BackgroundColor="#F8FAFD" HeightRequest="52" />
                        </VerticalStackLayout>
                        <Border x:Name="InspectionResultPanel" BackgroundColor="#EAF4FF" Stroke="#BBD8FF" StrokeThickness="1" Padding="16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                                    <Label Text="质检结果" TextColor="#0042AD" FontSize="14" FontAttributes="Bold" Margin="0,0,8,0" VerticalOptions="Center" />
                                    <Button x:Name="InspectionRulesButton" Text="ⓘ 规则说明" FontSize="12" FontAttributes="Bold" TextColor="#0042AD" BackgroundColor="#EAF4FF"
                                            MinimumHeightRequest="44" MinimumWidthRequest="100" Padding="8,0" CornerRadius="10" Clicked="OnInspectionRulesClicked"
                                            SemanticProperties.Description="查看质检结果自动判断规则" />
                                </FlexLayout>
                                <Picker x:Name="InspectResultPicker" BackgroundColor="#F8FAFD" TextColor="#051B3D" HeightRequest="52" SelectedIndexChanged="OnInspectResultChanged" />
                            </VerticalStackLayout>
                        </Border>
                        <VerticalStackLayout x:Name="UnqualifiedDescriptionPanel" Spacing="8" IsVisible="False">
                            <Label Text="不合格说明 *" TextColor="#051B3D" FontAttributes="Bold" />
                            <Editor x:Name="UnqualifiedDescriptionEditor" Placeholder="选为不合格时必填原因" AutoSize="TextChanges" HeightRequest="90" BackgroundColor="#F8FAFD" />
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="MemoInputPanel" Spacing="8">
                            <Label x:Name="MemoLabel" Text="质检备注" TextColor="#051B3D" FontAttributes="Bold" />
                            <Editor x:Name="MemoEditor" Placeholder="填写其他备注信息..." AutoSize="TextChanges" HeightRequest="90" BackgroundColor="#F8FAFD" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Grid x:Name="ActionBar" Grid.Row="2" Margin="6,16" ColumnDefinitions="2*,*" ColumnSpacing="12" IsVisible="False">
            <Button x:Name="SubmitButton" IsVisible="False" Text="提交质检" TextColor="#0B3D8B" BackgroundColor="White" BorderColor="#0B3D8B" BorderWidth="1" CornerRadius="10" HeightRequest="54" FontAttributes="Bold" Clicked="OnSubmitClicked" />
            <Button x:Name="CompleteButton" Grid.Column="1" IsVisible="False" Text="完 成" TextColor="White" BackgroundColor="#244B88" CornerRadius="10" HeightRequest="54" FontAttributes="Bold" Clicked="OnCompleteClicked" />
        </Grid>
    </Grid>
</ContentPage>
